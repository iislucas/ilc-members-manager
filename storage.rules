rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function getUserEmail() {
      return (request.auth != null && 'email' in request.auth.token) ? request.auth.token.email : '';
    }

    function getAclPath() {
      let email = getUserEmail();
      return email != '' ? /databases/(default)/documents/acl/$(email) : /databases/(default)/documents/acl/_invalid_;
    }

    function isAdmin() {
      let email = getUserEmail();
      let aclPath = getAclPath();
      return email != '' && firestore.exists(aclPath) && firestore.get(aclPath).data.get('isAdmin', false) == true;
    }

    // Returns the list of member document IDs linked to this user's ACL.
    function getUserMemberDocIds() {
      let email = getUserEmail();
      let aclPath = getAclPath();
      return (email != '' && firestore.exists(aclPath)) ? firestore.get(aclPath).data.memberDocIds : [];
    }

    // Returns the list of school document IDs this user owns or manages,
    // cached on the user's ACL document.
    function getUserSchoolDocIds() {
      let email = getUserEmail();
      let aclPath = getAclPath();
      return (email != '' && firestore.exists(aclPath)) ? firestore.get(aclPath).data.schoolDocIds : [];
    }

    match /backups/{backupFile} {
      // Only admins can read/write the backups
      allow read, write: if isAdmin();
    }
    
    // Event image uploads are allowed for the event's owner or managers,
    // checked via the ACL's memberDocIds against the event's ownerDocId
    // and managerDocIds fields.
    match /events/{eventId}/images/{fileId} {
      allow read: if true;
      allow write: if isAdmin() || (
        request.auth != null &&
        (
          firestore.get(/databases/(default)/documents/events/$(eventId)).data.ownerDocId in getUserMemberDocIds() ||
          getUserMemberDocIds().hasAny(
            firestore.get(/databases/(default)/documents/events/$(eventId)).data.get('managerDocIds', [])
          )
        )
      );
    }

    // Event document uploads follow the same owner/manager pattern as images.
    match /events/{eventId}/documents/{fileId} {
      allow read: if true;
      allow write: if isAdmin() || (
        request.auth != null &&
        (
          firestore.get(/databases/(default)/documents/events/$(eventId)).data.ownerDocId in getUserMemberDocIds() ||
          getUserMemberDocIds().hasAny(
            firestore.get(/databases/(default)/documents/events/$(eventId)).data.get('managerDocIds', [])
          )
        )
      );
    }

    // Private event materials (videos, photo dumps, and their previews).
    // Unlike images/documents above, read is ALSO restricted to admins and
    // the event's owner/managers — these files are not publicly visible.
    // The recursive wildcard covers the per-item `originals/{itemId}/...`
    // subfolders, the `previews/...` files, and listing on the prefix.
    match /events/{eventId}/materials/{material=**} {
      allow read, write: if isAdmin() || (
        request.auth != null &&
        (
          firestore.get(/databases/(default)/documents/events/$(eventId)).data.ownerDocId in getUserMemberDocIds() ||
          getUserMemberDocIds().hasAny(
            firestore.get(/databases/(default)/documents/events/$(eventId)).data.get('managerDocIds', [])
          )
        )
      );
    }

    // Private member & instructor uploaded materials (videos, photos, and previews).
    // Read and write restricted to admins and the owning member.
    match /members/{memberDocId}/materials/{material=**} {
      allow read, write: if isAdmin() || (
        request.auth != null && memberDocId in getUserMemberDocIds()
      );
    }

    // Instructor public profile images (profile picture and cover image).
    // Publicly readable. Writable by an admin or by the instructor whose
    // member document matches {memberDocId} (checked via the ACL's
    // memberDocIds). Stored at instructors/{memberDocId}/images/{fileId}.
    match /instructors/{memberDocId}/images/{fileId} {
      allow read: if true;
      allow write: if isAdmin() || (
        request.auth != null && memberDocId in getUserMemberDocIds()
      );
    }

    // School public profile images (logo/profile picture and cover image).
    // Publicly readable. Writable by an admin or by an owner/manager of the
    // school whose document matches {schoolDocId} (checked via the ACL's
    // schoolDocIds). Stored at schools/{schoolDocId}/images/{fileId}.
    match /schools/{schoolDocId}/images/{fileId} {
      allow read: if true;
      allow write: if isAdmin() || (
        request.auth != null && schoolDocId in getUserSchoolDocIds()
      );
    }

    // Construct today's date as a YYYY-MM-DD string from request.time.
    // Used for lexicographic comparison against stored expiry dates.
    function todayStr() {
      let y = string(request.time.year());
      let rawM = request.time.month();
      let m = rawM < 10 ? ('0' + string(rawM)) : string(rawM);
      let rawD = request.time.day();
      let d = rawD < 10 ? ('0' + string(rawD)) : string(rawD);
      return y + '-' + m + '-' + d;
    }

    // Check if the ACL's membershipExpires field grants access.
    // Values: "life" (always valid — 'l' > '9' in ASCII), "YYYY-MM-DD"
    // (valid if >= today), or "" / missing (no membership).
    function hasActiveMembership() {
      let email = getUserEmail();
      let aclPath = getAclPath();
      return email != '' && firestore.exists(aclPath) &&
        firestore.get(aclPath).data.get('membershipExpires', '') is string &&
        firestore.get(aclPath).data.get('membershipExpires', '') >= todayStr();
    }

    // Check if the ACL's instructorLicenseExpires field grants access.
    // Same value semantics as hasActiveMembership().
    function hasActiveInstructorLicense() {
      let email = getUserEmail();
      let aclPath = getAclPath();
      return email != '' && firestore.exists(aclPath) &&
        firestore.get(aclPath).data.get('instructorLicenseExpires', '') is string &&
        firestore.get(aclPath).data.get('instructorLicenseExpires', '') >= todayStr();
    }

    // Check if the ACL's schoolLicenseExpires field grants access.
    // The field tracks the latest school license expiry across all
    // schools this user owns or manages.
    function hasActiveSchoolLicense() {
      let email = getUserEmail();
      let aclPath = getAclPath();
      return email != '' && firestore.exists(aclPath) &&
        firestore.get(aclPath).data.get('schoolLicenseExpires', '') is string &&
        firestore.get(aclPath).data.get('schoolLicenseExpires', '') >= todayStr();
    }

    // Resources are organised into subdirectories by access level.
    // Write access (upload/delete) is always admin-only.
    match /resources/public/{fileId=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /resources/members/{fileId} {
      // Requires an active membership (Life or non-expired Annual).
      allow read: if request.auth != null && (isAdmin() || hasActiveMembership());
      allow write: if isAdmin();
    }
    match /resources/instructors/{fileId} {
      // Requires a valid instructor license.
      allow read: if request.auth != null && (isAdmin() || hasActiveInstructorLicense());
      allow write: if isAdmin();
    }
    match /resources/school-owners/{fileId} {
      // Requires an active school license (owner or manager of a
      // school with a valid license).
      allow read: if request.auth != null && (isAdmin() || hasActiveSchoolLicense());
      allow write: if isAdmin();
    }
    match /resources/admins/{fileId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    function getVideoData(videoId) {
      let videoPath = /databases/(default)/documents/videos/$(videoId);
      return firestore.exists(videoPath) ? firestore.get(videoPath).data : {};
    }

    function isVideoPublicOrTrailer(videoData) {
      return videoData.get('isTrailer', false) == true ||
        videoData.get('accessTier', '') == 'public' ||
        videoData.get('accessTiers', []).hasAny(['public']);
    }

    function hasVideoGrant(videoData, videoId) {
      let email = getUserEmail();
      let seriesId = videoData.get('seriesId', '');
      return email != '' && (
        firestore.exists(/databases/(default)/documents/video_grants/$(email + '_' + videoId)) ||
        (seriesId != '' && firestore.exists(/databases/(default)/documents/video_grants/$(email + '_' + seriesId)))
      );
    }

    function isVideoTierAllowed(videoData) {
      let allowsMembers = videoData.get('accessTier', '') in ['members', 'members_only'] ||
        videoData.get('accessTiers', []).hasAny(['members', 'members_only']) ||
        (!('accessTier' in videoData) && !('accessTiers' in videoData));
      let allowsInstructors = videoData.get('accessTier', '') in ['instructors', 'instructors_only'] ||
        videoData.get('accessTiers', []).hasAny(['instructors', 'instructors_only']);
      return (allowsMembers && (hasActiveMembership() || hasActiveInstructorLicense())) ||
        (allowsInstructors && hasActiveInstructorLicense());
    }

    // Video on Demand (VOD) transcoded streaming chunks and manifests.
    // Read is permitted for admins, trailers, public videos, active members/instructors
    // for videos in matching tiers, or members holding an explicit purchase grant.
    match /vod/{videoId}/{allFiles=**} {
      function isVodAuthorized() {
        let videoData = getVideoData(videoId);
        return isVideoPublicOrTrailer(videoData) || (
          request.auth != null && (
            isAdmin() ||
            hasVideoGrant(videoData, videoId) ||
            isVideoTierAllowed(videoData)
          )
        );
      }

      allow read: if isVodAuthorized();
      allow write: if isAdmin();
    }

    // Article & content post images uploaded via editor
    match /{coll}/{docId}/images/{fileId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // General editor image uploads
    match /editor-images/{fileId} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    match /{allPaths=**} {
      // Deny by default
      allow read, write: if false;
    }
  }
}
