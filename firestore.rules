rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // Auth email helpers (case-insensitive email matching).
    //
    // Stored emails (members.emails, events.ownerEmails/managerEmails,
    // registration `email`, video_grants `memberEmail`) and `/acl/{email}`
    // doc ids are normalised to trimmed lowercase. Firebase Auth's
    // `request.auth.token.email` may contain uppercase letters, so we match
    // on the lowercased token email. During the transition (until the
    // backfill has lowercased all legacy data) the raw token email is
    // ALSO accepted wherever it was accepted before.
    // ------------------------------------------------------------------

    // True when the request carries a non-empty string email claim. Every
    // other helper below must only be evaluated behind this guard (or uses
    // it internally), so `.lower()` is never called on a missing claim.
    function hasAuthEmail() {
      return request.auth != null
        && request.auth.token.get('email', null) is string
        && request.auth.token.email.size() > 0;
    }

    // The raw token email. Only call after hasAuthEmail().
    function authEmailRaw() {
      return request.auth.token.email;
    }

    // The lowercased token email. Only call after hasAuthEmail().
    function authEmailLower() {
      return request.auth.token.email.lower();
    }

    // The acceptable forms of the caller's email: [raw, lowercase], or []
    // when there is no email claim (so `list.hasAny(authEmails())` and
    // `value in authEmails()` are safely false for email-less tokens).
    function authEmails() {
      return hasAuthEmail() ? [authEmailRaw(), authEmailLower()] : [];
    }

    // True if `emailList` contains the caller's email (lowercase or raw form).
    function isAuthEmailIn(emailList) {
      return emailList.hasAny(authEmails());
    }

    // Resolves the caller's ACL document path. Only call after hasAuthEmail().
    // The lowercase id (canonical, written by Cloud Functions) wins; the raw
    // id is a transition fallback used only if the token email has uppercase
    // letters, no lowercase ACL exists, and a raw-id ACL does exist.
    // Cost: 1 doc access for lowercase tokens (unchanged from before), at most
    // 2 (lowercase + raw) for mixed-case tokens. Repeated exists()/get() on the
    // same path within one request are de-duplicated by the rules engine.
    //
    // Avoid ternary assignment with `null` for paths (e.g. `cond ? /... : null`),
    // as the Firestore rules compiler expects both branches of a ternary to share
    // the same type, emitting a type warning when evaluating `null` as a path.
    function aclPath() {
      let raw = authEmailRaw();
      let lower = authEmailLower();
      let lowerPath = /databases/$(database)/documents/acl/$(lower);
      let rawPath = /databases/$(database)/documents/acl/$(raw);
      return (raw != lower && !exists(lowerPath) && exists(rawPath)) ? rawPath : lowerPath;
    }

    // True if the caller has an ACL document (lowercase or raw-id fallback).
    function hasAcl() {
      return hasAuthEmail() && exists(aclPath());
    }

    function isAdmin() {
      return hasAcl() && get(aclPath()).data.isAdmin == true;
    }

    function getUserMemberDocIds() {
      return hasAcl() ? get(aclPath()).data.memberDocIds : [];
    }

    function isFullMember() {
      return hasAcl() && get(aclPath()).data.get('notYetLinkedToMember', false) == false;
    }

    function isInstructor() {
      return hasAcl() && get(aclPath()).data.get('instructorIds', []).size() > 0;
    }

    // Returns the list of school document IDs this user owns or manages,
    // as cached in their ACL document by Cloud Functions triggers.
    function getUserSchoolDocIds() {
      return hasAcl() ? get(aclPath()).data.get('schoolDocIds', []) : [];
    }

    // Returns the list of instructor IDs cached on the caller's ACL document.
    function getUserInstructorIds() {
      return hasAcl() ? get(aclPath()).data.get('instructorIds', []) : [];
    }

    match /members/{memberDocId} {
      function isOwner() {
        return request.auth != null &&
               (isAuthEmailIn(resource.data.emails) || 
                (memberDocId in getUserMemberDocIds()));
      }
      // Checks whether the authenticated user manages the school that
      // this member belongs to, using the ACL's cached schoolDocIds.
      function isManagerOfMemberSchool() {
        let schoolDocId = resource.data.primarySchoolDocId;
        return schoolDocId != "" && schoolDocId in getUserSchoolDocIds();
      }
      function hasValidEditUpdate() {
        return request.resource.data.lastUpdated == request.time;
      }
      allow read: if isOwner() || isAdmin() || isManagerOfMemberSchool();
      allow delete: if isAdmin() && !isOwner();
      allow create, update: if hasValidEditUpdate() && isAdmin();
      allow update: if hasValidEditUpdate() && isManagerOfMemberSchool() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['lastUpdated', 'name', 'instructorWebsite', 'publicClassGoogleCalendarId', 'publicRegionOrCity', 'publicCountyOrState',
           'publicEmail', 'publicPhone', 'address', 'city', 'countyOrState', 'zipCode', 'country', 'phone',
           'emails', 'gender', 'dateOfBirth', 'primaryInstructorId', 'primarySchoolId', 'primarySchoolDocId',
           'notificationSettings', 'publicProfileImageUrl', 'publicProfileImageThumbUrl', 'publicCoverImageUrl', 'publicBioMarkdown',
           'membershipType', 'firstMembershipStarted', 'lastRenewalDate', 'currentMembershipExpires',
           'studentLevel', 'applicationLevel', 'mastersLevels',
           'instructorId', 'instructorLicenseExpires', 'instructorLicenseRenewalDate', 'instructorLicenseType',
           'notes']);
      allow update: if hasValidEditUpdate() && isOwner() && 
         (!('emails' in request.resource.data.diff(resource.data).affectedKeys()) || isAuthEmailIn(request.resource.data.emails)) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['lastUpdated', 'name', 'instructorWebsite', 'publicClassGoogleCalendarId', 'publicRegionOrCity', 'publicCountyOrState',
           'publicEmail', 'publicPhone', 'address', 'city', 'countyOrState', 'zipCode', 'country', 'phone',
           'emails', 'gender', 'dateOfBirth', 'primaryInstructorId', 'primarySchoolId', 'primarySchoolDocId',
           'notificationSettings', 'publicProfileImageUrl', 'publicProfileImageThumbUrl', 'publicCoverImageUrl', 'publicBioMarkdown']);

      match /notifications/{notificationId} {
        function isNotificationOwner() {
          return request.auth != null &&
                 ((isAuthEmailIn(get(/databases/$(database)/documents/members/$(memberDocId)).data.emails)) || 
                  (memberDocId in getUserMemberDocIds()));
        }
        allow read: if isNotificationOwner() || isAdmin();
        allow create: if isNotificationOwner() || isAdmin();
        allow delete: if isNotificationOwner() || isAdmin();
        // The owner may dismiss a notification and may refresh the content of
        // their own notifications during client-side reconciliation (keeping a
        // notification's markdown/data/kind in step with the source it was generated
        // from). Owners can already create/delete their own notifications, so this
        // grants no new authority; it just keeps the writable surface scoped to
        // these fields (createdAt stays immutable).
        allow update: if (isNotificationOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dismissed', 'markdown', 'data', 'kind'])) || isAdmin();
      }

      // Web Push subscriptions for this member's devices. The member manages
      // their own subscriptions from the client; the push-sending Cloud
      // Function reads/prunes them via the Admin SDK (which bypasses rules).
      match /pushSubscriptions/{subId} {
        function isSubscriptionOwner() {
          return request.auth != null &&
                 ((isAuthEmailIn(get(/databases/$(database)/documents/members/$(memberDocId)).data.emails)) ||
                  (memberDocId in getUserMemberDocIds()));
        }
        allow read, write: if isSubscriptionOwner() || isAdmin();
      }

      // Member uploaded materials (videos, photos, files) metadata subcollection.
      // Readable by the upload owner, admins, or managers of a linked event.
      // Writable by the upload owner or admins.
      match /uploads/{uploadDocId} {
        function isUploadOwner() {
          return request.auth != null &&
                 ((isAuthEmailIn(get(/databases/$(database)/documents/members/$(memberDocId)).data.emails)) ||
                  (memberDocId in getUserMemberDocIds()));
        }
        function isLinkedEventManager() {
          let eventDocId = resource.data.get('eventDocId', '');
          let eventPath = /databases/$(database)/documents/events/$(eventDocId);
          return eventDocId != '' && exists(eventPath) && (
            get(eventPath).data.ownerDocId in getUserMemberDocIds() ||
            getUserMemberDocIds().hasAny(get(eventPath).data.get('managerDocIds', []))
          );
        }
        allow read: if isUploadOwner() || isAdmin() || isLinkedEventManager();
        allow write: if isUploadOwner() || isAdmin();
      }

      // Member orders and renewals subcollection.
      // Members can read their own order rows; Admins can read all orders.
      // Direct writes from the client are forbidden (written by Cloud Functions / Admin SDK).
      match /orders/{orderDocId} {
        function isOrderOwner() {
          return request.auth != null &&
                 ((isAuthEmailIn(get(/databases/$(database)/documents/members/$(memberDocId)).data.emails)) ||
                  (memberDocId in getUserMemberDocIds()));
        }
        allow read: if isOrderOwner() || isAdmin();
        allow write: if isAdmin();
      }

      // Member video grants (specific purchased/granted VOD access)
      match /videoGrants/{videoId} {
        function isGrantOwner() {
          return request.auth != null &&
                 ((isAuthEmailIn(get(/databases/$(database)/documents/members/$(memberDocId)).data.emails)) ||
                  (memberDocId in getUserMemberDocIds()));
        }
        allow read: if isGrantOwner() || isAdmin();
        allow write: if isAdmin();
      }

      // Member video watch progress
      match /videoProgress/{videoId} {
        function isProgressOwner() {
          return request.auth != null &&
                 ((isAuthEmailIn(get(/databases/$(database)/documents/members/$(memberDocId)).data.emails)) ||
                  (memberDocId in getUserMemberDocIds()));
        }
        allow read, write: if isProgressOwner() || isAdmin();
      }

      // Member video time ranges / annotations
      match /videoTimeRanges/{videoId} {
        function isTimeRangeOwner() {
          return request.auth != null &&
                 ((isAuthEmailIn(get(/databases/$(database)/documents/members/$(memberDocId)).data.emails)) ||
                  (memberDocId in getUserMemberDocIds()));
        }
        allow read, write: if isTimeRangeOwner() || isAdmin();
      }

      // Member event registrations
      match /registrations/{registrationId} {
        function isRegistrationOwner() {
          return request.auth != null &&
                 ((isAuthEmailIn(get(/databases/$(database)/documents/members/$(memberDocId)).data.emails)) ||
                  (memberDocId in getUserMemberDocIds()));
        }
        allow read: if isRegistrationOwner() || isAdmin();
        allow write: if isAdmin();
      }
    }

    // Collection group query support for /uploads
    match /{path=**}/uploads/{uploadDocId} {
      function isLinkedEventManager() {
        let eventDocId = resource.data.get('eventDocId', '');
        let eventPath = /databases/$(database)/documents/events/$(eventDocId);
        return eventDocId != '' && exists(eventPath) && (
          get(eventPath).data.ownerDocId in getUserMemberDocIds() ||
          getUserMemberDocIds().hasAny(get(eventPath).data.get('managerDocIds', []))
        );
      }
      allow read: if isAdmin() || isLinkedEventManager();
      allow write: if isAdmin();
    }

    match /instructors/{instructorMemberDocId} {
      allow read: if true;
      allow write: if false; // Locked down to Cloud Functions
      
      match /members/{studentMemberDocId} {
        allow read: if isAdmin() || instructorMemberDocId in getUserMemberDocIds();
        allow write: if isAdmin();
      }
      
      match /gradings/{gradingId} {
        allow read: if isAdmin() || instructorMemberDocId in getUserMemberDocIds();
        allow write: if isAdmin();
      }
    }

    match /schools/{schoolDocId} {
      // Uses the ACL's cached schoolDocIds instead of looking up
      // ownerEmails/managerEmails on the school document.
      function isSchoolManager() {
        return schoolDocId in getUserSchoolDocIds();
      }
      function hasValidEditUpdate() {
        return request.resource.data.lastUpdated == request.time;
      }
      allow read: if true;
      allow write: if hasValidEditUpdate() && isAdmin();
      allow delete: if isAdmin();
      allow update: if hasValidEditUpdate() && isSchoolManager() && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['lastUpdated', 'schoolName', 'schoolAddress', 'schoolCity', 'schoolZipCode', 'schoolCountyOrState', 'schoolCountry', 'schoolWebsite', 'schoolClassGoogleCalendarId', 'managerInstructorIds', 'publicProfileImageUrl', 'publicProfileImageThumbUrl', 'publicCoverImageUrl', 'publicBioMarkdown']);
    
      match /members/{memberDocId} {
        allow read: if isAdmin() || isSchoolManager();
        allow write: if isAdmin();
      }

      match /gradings/{gradingId} {
        allow read: if isAdmin() || isSchoolManager();
        allow write: if isAdmin();
      }
    }

    match /acl/{email} {
      allow read: if (request.auth != null && email in authEmails()) || isAdmin();
      allow write: if isAdmin();
    }

    match /system/country-codes {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system/video-tags {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Cached Stripe catalogue. Publicly readable: the purchase pages show
    // their price structure to visitors who have not signed in yet.
    match /system/stripe-products {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Global mail settings (sending status: active, paused, off).
    // Publicly readable so clients know if email notifications are active/paused/off.
    match /system/mail-settings {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Mail secrets (e.g. HMAC unsubscribe secret). Admin only.
    match /system/mail-secrets {
      allow read, write: if isAdmin();
    }

    match /system/deletions/{collectionName}/{document=**} {
      allow read: if (collectionName in ['instructors', 'schools', 'events', 'videos', 'products']) || isAdmin();
      allow write: if isAdmin();
    }

    match /system/{document=**} {
      allow read, write: if isAdmin();
    }

    match /deletion_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /statistics/{statId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Outbound email task queue.
    // Client creation is blocked (all outbound mail must be created via Cloud Functions).
    // Admins can read, update, and delete queue items (except items actively in PROCESSING).
    match /mail/{mailId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin() &&
        resource.data.status != 'PROCESSING' &&
        (!('delivery' in resource.data) || resource.data.delivery.state != 'PROCESSING');
    }

    // Products for classes, workshops, and events.
    // Publicly readable so anyone can view class offerings and prices.
    // Writable only by admins.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Cached calendar events — publicly readable as events are public.
    // Owner/manager access uses the ACL's memberDocIds rather than
    // redundant email arrays on the event document.
    match /events/{eventId} {
      function isEventOwnerOrManager() {
        return request.auth != null && (
          resource.data.ownerDocId in getUserMemberDocIds() ||
          getUserMemberDocIds().hasAny(resource.data.get('managerDocIds', []))
        );
      }
      function hasValidEditUpdate() {
        return request.resource.data.lastUpdated == request.time;
      }
      allow read: if true;
      allow create: if isAdmin();
      allow delete: if isAdmin() || (
        isEventOwnerOrManager() &&
        resource.data.status == 'proposed'
      );
      allow update: if hasValidEditUpdate() && (isAdmin() || (
        isEventOwnerOrManager() && (
          request.resource.data.status == resource.data.status ||
          request.resource.data.status == 'cancelled'
        )
      ));

      match /registrations/{registrationId} {
        function isParentEventOwnerOrManager() {
          let eventDoc = get(/databases/$(database)/documents/events/$(eventId));
          return request.auth != null && (
            eventDoc.data.ownerDocId in getUserMemberDocIds() ||
            getUserMemberDocIds().hasAny(eventDoc.data.get('managerDocIds', [])) ||
            isAuthEmailIn(eventDoc.data.get('ownerEmails', [])) ||
            isAuthEmailIn(eventDoc.data.get('managerEmails', []))
          );
        }
        allow read: if isAdmin() || isParentEventOwnerOrManager() || (
          request.auth != null && (
            resource.data.memberDocId in getUserMemberDocIds() ||
            resource.data.email in authEmails()
          )
        );
        allow write: if isAdmin();
      }
    }

    // Member subcollection for events
    match /members/{memberDocId}/events/{eventId} {
      allow read: if request.auth != null && (
        isAuthEmailIn(get(/databases/$(database)/documents/members/$(memberDocId)).data.emails) || 
        memberDocId in getUserMemberDocIds() || 
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // Cached members-area blog posts — readable by authenticated users.
    // Fine-grained membership checks are done in the frontend component;
    // the rule here ensures only logged-in users can access the data.
    match /members-post/{postId} {
      allow read: if request.auth != null && (isAdmin() || isFullMember());
      allow write: if isAdmin();
    }

    // Cached instructors blog posts — readable by active instructors or admins.
    match /instructors-post/{postId} {
      allow read: if request.auth != null && (isAdmin() || isInstructor());
      allow write: if isAdmin();
    }

    // Public articles & wiki posts — readable by anyone (public), writable only by admin.
    match /articles-post/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gradings/{gradingId} {
      function isGradingStudent() {
        return resource.data.studentMemberDocId in getUserMemberDocIds();
      }
      // Returns true for the primary grading instructor AND for grading managers
      // (stored in `gradingManagerIds`). Both roles share the same edit permissions.
      function isGradingManager() {
        let instructorIds = getUserInstructorIds();
        let managers = resource.data.get('gradingManagerIds', []);
        let assigned = resource.data.get('assignedInstructorId', '');
        return resource.data.gradingInstructorId in instructorIds || instructorIds.hasAny(managers) || (assigned != '' && assigned in instructorIds);
      }
      // True when the user is the organizer or a manager of the event this
      // grading is linked to (via gradingEventDocId). Derived live from the
      // event document so unlinking/relinking automatically revokes/grants
      // access. Guarded so the extra get() only happens when actually linked.
      function isGradingEventManager() {
        let eventDocId = resource.data.get('gradingEventDocId', '');
        let eventPath = /databases/$(database)/documents/events/$(eventDocId);
        return eventDocId != '' && exists(eventPath) && (
          get(eventPath).data.ownerDocId in getUserMemberDocIds() ||
          getUserMemberDocIds().hasAny(get(eventPath).data.get('managerDocIds', []))
        );
      }
      // Uses the ACL's cached schoolDocIds instead of looking up
      // ownerEmails/managerEmails on the school document.
      function isGradingSchoolManager() {
        let schoolDocId = resource.data.get('schoolDocId', '');
        return schoolDocId != "" && schoolDocId in getUserSchoolDocIds();
      }
      function hasValidEditUpdate() {
        return request.resource.data.lastUpdated == request.time;
      }
      // A grading is "accepted" once a grading manager has accepted the request
      // (status moves to AwaitingGrading) or it has progressed beyond that. From
      // this point the linked event becomes the grading manager's responsibility,
      // so the student may no longer change the event fields.
      function gradingIsAccepted() {
        let status = resource.data.status;
        return status == 'awaiting-instructor-grading' || status == 'passed' ||
               status == 'not-passed' || status == 'in-review';
      }
      allow read: if isAdmin() || isGradingStudent() || isGradingManager() || isGradingSchoolManager() || isGradingEventManager();
      allow write: if hasValidEditUpdate() && isAdmin();
      allow delete: if isAdmin();
      allow update: if hasValidEditUpdate() && (isGradingManager() || isGradingEventManager()) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['lastUpdated', 'status', 'gradingEventDate', 'gradingEvent', 'gradingEventDocId',
             'notes', 'instructorAcceptedDate', 'acceptedByMemberDocId', 'acceptedByName',
             'statusChangedByMemberDocId', 'statusChangedByName',
             'gradingInstructorId', 'resultNotes', 'gradingManagerIds',
             'paymentStatus', 'paymentNote', 'studentLevelAtAcceptance', 'applicationLevelAtAcceptance',
             'declineNotes']);
      // Before acceptance the student owns the linked event and request fields.
      // Students may only move status to pending or awaiting-instructor-acceptance.
      allow update: if hasValidEditUpdate() && isGradingStudent() && !gradingIsAccepted() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['lastUpdated', 'status', 'gradingEvent', 'gradingEventDate', 'gradingEventDocId',
             'gradingInstructorId', 'studentNotes', 'declineNotes',
             'statusChangedByMemberDocId', 'statusChangedByName']) &&
          request.resource.data.status in [resource.data.status, 'pending', 'awaiting-instructor-acceptance'];
      // After acceptance the event fields and status belong to the grading manager/admin,
      // so the student may update notes/instructors but no longer the linked event or status.
      allow update: if hasValidEditUpdate() && isGradingStudent() && gradingIsAccepted() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['lastUpdated', 'gradingInstructorId', 'studentNotes', 'declineNotes',
             'statusChangedByMemberDocId', 'statusChangedByName']);
    }

    // Public video on demand catalog
    match /videos/{videoId} {
      allow read: if isAdmin() || resource.data.get('isPublished', false) == true;
      allow write: if isAdmin();
    }

    // Global video access grants
    match /video_grants/{grantId} {
      allow read: if isAdmin() || (
        request.auth != null && (
          (hasAuthEmail() &&
            (authEmailLower() == resource.data.memberEmail ||
             authEmailRaw() == resource.data.memberEmail)) ||
          resource.data.memberDocId in getUserMemberDocIds()
        )
      );
      allow write: if isAdmin();
    }
  }
}