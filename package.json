{
  "packageManager": "pnpm@11.22.0",
  "name": "ilc-members-manager",
  "version": "0.0.1",
  "scripts": {
    "backfill:event-materials": "pnpm --prefix functions exec ts-node -O '{\"module\": \"commonjs\"}' ../scripts/backfill-event-materials.ts",
    "build:all": "pnpm run build && pnpm run build:functions",
    "build:events-wc": "ng build --project events-viewer-wc",
    "build:find-instructor-wc": "ng build --project find-an-instructor-wc",
    "build:fixtures": "pnpm --prefix functions exec ts-node scripts/build-fixture-subset.ts",
    "build:functions": "pnpm --prefix functions run build",
    "build": "ng build --project ilc-members-manager",
    "deploy:events-wc": "ts-node -O '{\"module\": \"commonjs\"}' scripts/deploy-events-wc.ts",
    "deploy:find-instructor-wc": "ts-node -O '{\"module\": \"commonjs\"}' scripts/deploy-find-instructor-wc.ts",
    "deploy:functions": "pnpm run build:functions && firebase deploy --only functions",
    "deploy:hosting": "pnpm run build && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "deploy": "pnpm run build:all && firebase deploy",
    "emulator:start": "firebase emulators:start --only auth,firestore,functions,storage",
    "export:anonymized": "pnpm --prefix functions exec ts-node scripts/export-anonymized-data.ts --project ilc-paris-class-tracker",
    "mcp": "ng mcp",
    "ng": "ng",
    "postinstall": "cd functions && pnpm install",
    "prebuild": "pnpm run stamp-version",
    "register:stripe-webhook": "ts-node -O '{\"module\": \"commonjs\", \"esModuleInterop\": true}' scripts/register-stripe-webhook.ts",
    "seed:emulator": "pnpm --prefix functions exec ts-node scripts/seed-emulator.ts",
    "stamp-version": "ts-node -O '{\"module\": \"commonjs\"}' scripts/stamp-version.ts",
    "start:emulator": "ng serve --configuration emulator --project ilc-members-manager",
    "start:events-wc": "ng serve --project events-viewer-wc",
    "start:find-instructor-wc": "ng serve --project find-an-instructor-wc",
    "start": "ng serve --project ilc-members-manager",
    "test:e2e:in_emulator": "vitest run --config vitest.e2e.config.ts --no-color",
    "test:e2e": "pnpm build:functions && pnpm exec firebase emulators:exec --only firestore,functions --project demo-ilc-test \"pnpm test:e2e:in_emulator\"",
    "test:fixtures": "vitest run --config vitest.fixtures.config.ts --no-color",
    "test:functions": "pnpm --prefix functions test",
    "test:once": "vitest run --no-color",
    "test:rules:in_emulator": "vitest run --config vitest.rules.config.ts --no-color",
    "test:rules": "pnpm exec firebase emulators:exec --only firestore \"pnpm test:rules:in_emulator\"",
    "test:watch": "vitest --no-color",
    "test": "pnpm test:once",
    "backfill:timestamps": "ts-node -O '{\"module\": \"commonjs\"}' scripts/backfill-collection-timestamps.ts",
    "backfill:video-series": "ts-node -O '{\"module\": \"commonjs\", \"esModuleInterop\": true}' scripts/backfill-video-series.ts",
    "typecheck:tests": "tsc -p tsconfig.spec.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "generate:diagram": "ts-node -O '{\"module\": \"commonjs\", \"esModuleInterop\": true}' docs/minitools/diagram-router/scripts/generate-architecture-diagram.ts",
    "test:diagram": "vitest run --config docs/minitools/diagram-router/vitest.config.ts --no-color",
    "sync:video-products": "pnpm --prefix functions exec ts-node -O '{\"module\": \"commonjs\", \"esModuleInterop\": true}' scripts/sync-video-stripe-products.ts",
    "vimeo:inventory": "pnpm --prefix functions exec ts-node -O '{\"module\": \"commonjs\", \"esModuleInterop\": true}' ../scripts/vimeo-inventory.ts",
    "vimeo:migrate": "pnpm --prefix functions exec ts-node -O '{\"module\": \"commonjs\", \"esModuleInterop\": true}' ../scripts/vimeo-migrate-to-gcs.ts",
    "watch": "ng build --watch --configuration development --project ilc-members-manager"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.10",
    "@angular/compiler": "^21.2.10",
    "@angular/core": "^21.2.10",
    "@angular/elements": "^21.2.10",
    "@angular/forms": "^21.2.10",
    "@angular/platform-browser": "^21.2.10",
    "@angular/platform-browser-dynamic": "^21.2.10",
    "@angular/router": "^21.2.10",
    "@angular/service-worker": "^21.2.10",
    "@milkdown/core": "7.20.0",
    "@milkdown/plugin-history": "7.20.0",
    "@milkdown/plugin-indent": "7.20.0",
    "@milkdown/plugin-listener": "7.20.0",
    "@milkdown/preset-commonmark": "7.20.0",
    "@milkdown/prose": "7.20.0",
    "@milkdown/utils": "7.20.0",
    "@types/papaparse": "^5.3.16",
    "date-fns": "^4.1.0",
    "fast-deep-equal": "^3.1.3",
    "firebase": "^12.1.0",
    "firebase-tools": "^15.4.0",
    "hls.js": "^1.6.18",
    "marked": "^18.0.0",
    "minisearch": "^7.1.2",
    "papaparse": "^5.5.3",
    "rxjs": "~7.8.0",
    "skills": "^1.5.14",
    "ts-node": "^10.9.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.2.3",
    "@analogjs/vite-plugin-angular": "^2.2.3",
    "@analogjs/vitest-angular": "^2.2.3",
    "@angular/build": "^21.2.8",
    "@angular/cli": "^21.2.8",
    "@angular/compiler-cli": "^21.2.10",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@google-cloud/storage": "^7.19.0",
    "@types/node": "^26.0.0",
    "esbuild": "^0.28.0",
    "firebase-admin": "^13.10.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.6.2",
    "stripe": "^22.3.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18"
  }
}
